# --- THINK5 environment (copy to .env) ---
# PostgreSQL connection string (e.g. Neon). Use the DIRECT (non-pooled) URL.
# Example: postgresql://user:pass@ep-xxx.region.aws.neon.tech/neondb?sslmode=require
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"

# Session signing secret (generate a random 32+ char string in production)
AUTH_SECRET="dev-secret-change-me-please-32chars-min-000"

# --- AI provider ---
# AI_PROVIDER: "mock" (no key needed) or "anthropic"
AI_PROVIDER="mock"
# Set your key and switch AI_PROVIDER to "anthropic" to use the real Claude evaluator.
# If the key is empty, the app automatically falls back to the mock evaluator.
ANTHROPIC_API_KEY=""
# Most cost-effective: Claude Haiku 4.5 ($1 / $5 per 1M tokens)
ANTHROPIC_MODEL="claude-haiku-4-5"
