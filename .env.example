# --- THINK5 environment (copy to .env) ---
DATABASE_URL="file:./dev.db"

# Session signing secret (generate a random 32+ char string in production)
AUTH_SECRET="dev-secret-change-me-please-32chars-min-000"

# --- AI provider ---
# AI_PROVIDER: "mock" (default, no key needed) or "anthropic"
AI_PROVIDER="mock"
# Set your key and switch AI_PROVIDER to "anthropic" to use the real Claude evaluator.
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-opus-4-8"
